# === Channel 啟用 ===
# comma-separated；可選：macos, discord, slack
CLAUDE_NOTIFY_CHANNELS=macos

# === 共用 ===
# 顯示在通知上的專案名稱（不設則用目錄名）
CLAUDE_PROJECT_NAME=dotclaude

# === Discord ===
# 啟用 discord channel 時必填
CLAUDE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# === Slack ===
# 啟用 slack channel 時必填（incoming webhook URL）
CLAUDE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# === Truncate 長度上限（可選） ===
CLAUDE_NOTIFY_MACOS_MAX_LEN=50
CLAUDE_NOTIFY_DISCORD_MAX_LEN=500
CLAUDE_NOTIFY_SLACK_MAX_LEN=500
